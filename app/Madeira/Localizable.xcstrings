    },
    "0: a Vulkan loader an installer wrote stays in system32": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0: 安装器写到的 Vulkan加载器留在系统32"
