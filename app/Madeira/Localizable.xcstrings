    "The library file could not be read. Preserve or repair it before making changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bibliotheksdatei konnte nicht gelesen werden. Sichere oder repariere sie vor Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo de la biblioteca. Haz una copia o repáralo antes de hacer cambios."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리 파일을 읽을 수 없습니다. 변경하기 전에 파일을 백업하거나 복구하세요."
          }
