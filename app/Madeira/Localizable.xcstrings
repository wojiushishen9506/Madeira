    "Swap coverage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap-Abdeckung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobertura de intercambio"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스왑 범위"
          }
        },
        "pt-BR": {
