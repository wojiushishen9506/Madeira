      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「玻璃」使用系统的液态玻璃效果。「实心」使用不透明的圆形按钮。仍可在游戏内用「不透明度」滑块调整透明度。"
          }
