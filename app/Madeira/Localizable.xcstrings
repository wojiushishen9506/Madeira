            "state": "translated",
            "value": "Cobertura do swap"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Охват подкачки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
