    },
    "0: any 32-bit program may take the held window, as before 2026-11-02": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0: 任何32位程序都可能像2026-11-02之前一样占用被持有的窗口"
          }
        }
      }
    },
    "0: child processes boot at once, side by side, as before ml1213": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
