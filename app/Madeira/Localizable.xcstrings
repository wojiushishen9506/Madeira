        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine Mono, 32-和 64-bit:mscore 设置了 MONO_THREADS_SUSPEND=coop，并在 Mono加载之前添加了 MONO_DEBUG 的 保留代表，并在 Mono 读取后将之前的值放回(ml1282); 已经设置的值为 win. 0 设置无."
          }
        }
      }
